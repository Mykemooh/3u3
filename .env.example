NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Postgres connection string. On Vercel, add Postgres from the Storage tab
# and this is set for you automatically (as POSTGRES_URL). For local dev,
# point it at any Postgres instance, e.g.:
# POSTGRES_URL=postgres://user:password@localhost:5432/3u3
POSTGRES_URL=

# ---- Job photo & video storage ------------------------------------------
# Recommended: Cloudflare R2 — 10 GB free every month and no charge for
# people viewing the files. Photos and videos upload straight from the
# crew's phone to R2 (never through Vercel, which caps uploads at ~4.5 MB).
# Set all five to switch it on; leave any blank to fall back to Blob below.
# Setup steps: docs/storage-r2.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# How long photos/videos stick around before the daily clean-up job
# deletes them (lib/mediaRetention.ts) — defaults apply even if you leave
# these blank (photos: 180 days, videos: 30), since Vercel Blob's free
# tier is a hard 1 GB cap that locks out all Blob access for 30 days if
# exceeded, not an overage charge. Set either to "0" to keep that kind
# forever instead. Needs CRON_SECRET set too.
PHOTO_RETENTION_DAYS=
VIDEO_RETENTION_DAYS=
# Extra safety net alongside the retention days above: if total stored
# media ever exceeds this many MB, the clean-up job deletes the oldest
# finished-job files (regardless of their own retention window) until
# back under it. Defaults to 800 (leaves ~200 MB headroom under Blob's
# 1 GB cap) even if left blank; set to "0" to disable.
MEDIA_STORAGE_BUDGET_MB=
# Any long random string. Vercel sends it to the daily clean-up job.
CRON_SECRET=

# Business timezone for "today" and "upcoming". Defaults to Katy's.
# BUSINESS_TIMEZONE=America/Chicago

# Vercel Blob token for job photo uploads (fallback when R2 isn't set). On Vercel, add Blob from the
# Storage tab and this is set for you automatically. Leave blank for local
# dev — the app falls back to writing photos under public/uploads/ locally.
BLOB_READ_WRITE_TOKEN=

# Real email sending (customer quote-visit confirmation + owner new-lead
# alert, PRD section 6.6) via Resend (https://resend.com — free tier).
# Leave RESEND_API_KEY blank and the app still works: sends are logged to
# notification_log but not actually delivered, and a console warning notes
# what would have been sent.
RESEND_API_KEY=
EMAIL_FROM="3U3 Cleaning <onboarding@resend.dev>"

# Optional fallback for the owner's new-lead alert email, only used if no
# ADMIN-role user exists yet in the database.
ADMIN_NOTIFICATION_EMAIL=

# Stripe — powers the invoicing/payment/receipt tail end (quote visit ->
# job -> invoice -> payment -> receipt). Get both from the Stripe
# Dashboard (Developers -> API keys / Webhooks). Use TEST mode keys until
# you're ready to take real payments.
#
# STRIPE_SECRET_KEY: without it, sending an invoice fails with a clear
# error (the app itself still runs fine otherwise).
# STRIPE_WEBHOOK_SECRET: from Developers -> Webhooks -> add an endpoint
# pointing at <your-app-url>/api/stripe/webhook, subscribed to at least
# `invoice.paid` and `checkout.session.completed` (the latter is what
# confirms a tip, below). Without this set, payments will go through on
# Stripe's side but this app will never learn about them (no "PAID"
# status, no receipt email) -- so set this up before sending any real
# invoice.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mapbox — the "crew is on the way" live map on the client's booking page
# (free tier: 50k map loads, 100k directions, 100k geocoding requests a
# month). Account page -> Tokens -> copy the Default public token (pk.…).
# It's sent to the browser to draw the map, so it must be a public token.
# Leave blank and "Start driving" still emails the client; they just get
# no map or ETA.
MAPBOX_ACCESS_TOKEN=
# Optional. If you add URL restrictions to the public token above (a good
# idea), Mapbox will refuse it for the server's own route and address
# lookups — put a second, unrestricted token here for those.
# MAPBOX_SERVER_TOKEN=

# Optional: text messages via Twilio (https://www.twilio.com). Used for
# "forgot password" links when someone asks with their phone number, and
# for booking/quote reminders if a client picks "Text message" in My
# Account. Leave any blank and those go to email instead.
# TWILIO_FROM_NUMBER is your Twilio number in +1XXXXXXXXXX form.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: WhatsApp, as a third notification-channel choice in My
# Account, via the same Twilio account above (SID/AUTH_TOKEN shared) plus
# a WhatsApp-enabled sender. Twilio's free sandbox number works for
# development (the recipient has to text the sandbox's join code once); a
# real business sender needs free WhatsApp Business verification through
# Twilio/Meta before production messages outside an active 24-hour
# conversation will deliver with freeform text. Leave blank and WhatsApp
# just isn't offered as an option.
TWILIO_WHATSAPP_FROM=

# My Account -> "Update payment information" (Stripe's own Payment
# Element collects the card; this app never sees or stores a card
# number) and autopay. Get both from the Stripe Dashboard -> Developers ->
# API keys. NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is sent to the browser (by
# design -- it's the publishable one); STRIPE_SECRET_KEY is also already
# needed for invoicing above. Leave either blank and the payment-method
# card in My Account just says it isn't set up yet.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: QuickBooks Online sync (Admin -> Integrations) -- pushes every
# paid invoice over as a sales receipt. Free to register an app for at
# https://developer.intuit.com; QuickBooks Online itself is the
# business's own subscription, same as Stripe's processing fees are
# theirs. QUICKBOOKS_ENVIRONMENT is "sandbox" while testing against a
# test company, "production" once connected to a real one. Leave
# CLIENT_ID/SECRET blank and "Connect QuickBooks" just explains that.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox

# ---- Sign-in -------------------------------------------------------------
# "Continue with Google" on every portal's sign-in page. Create an OAuth
# client at https://console.cloud.google.com/apis/credentials (type: Web
# application) with this redirect URI:
#   <your-app-url>/api/auth/callback/google
# Leave blank and the Google button simply isn't shown. Google only signs
# in people whose email is already on an account here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Name shown in authenticator apps next to the 6-digit code. Defaults to
# "TrashCan".
# MFA_ISSUER=3U3 Cleaning
