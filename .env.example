NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Postgres connection string. On Vercel, add Postgres from the Storage tab
# and this is set for you automatically (as POSTGRES_URL). For local dev,
# point it at any Postgres instance, e.g.:
# POSTGRES_URL=postgres://user:password@localhost:5432/3u3
POSTGRES_URL=

# Vercel Blob token for job photo uploads. On Vercel, add Blob from the
# Storage tab and this is set for you automatically. Leave blank for local
# dev — the app falls back to writing photos under public/uploads/ locally.
BLOB_READ_WRITE_TOKEN=

# Real email sending (customer quote-visit confirmation + owner new-lead
# alert, PRD section 6.6) via Resend (https://resend.com — free tier).
# Leave RESEND_API_KEY blank and the app still works: sends are logged to
# notification_log but not actually delivered, and a console warning notes
# what would have been sent.
RESEND_API_KEY=
EMAIL_FROM="3U3 Cleaning <onboarding@resend.dev>"

# Optional fallback for the owner's new-lead alert email, only used if no
# ADMIN-role user exists yet in the database.
ADMIN_NOTIFICATION_EMAIL=

# Stripe — powers the invoicing/payment/receipt tail end (quote visit ->
# job -> invoice -> payment -> receipt). Get both from the Stripe
# Dashboard (Developers -> API keys / Webhooks). Use TEST mode keys until
# you're ready to take real payments.
#
# STRIPE_SECRET_KEY: without it, sending an invoice fails with a clear
# error (the app itself still runs fine otherwise).
# STRIPE_WEBHOOK_SECRET: from Developers -> Webhooks -> add an endpoint
# pointing at <your-app-url>/api/stripe/webhook, subscribed to at least
# `invoice.paid`. Without this set, payments will go through on Stripe's
# side but this app will never learn about them (no "PAID" status, no
# receipt email) -- so set this up before sending any real invoice.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
