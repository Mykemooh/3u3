node_modules
.next
.data
# TypeScript's incremental build cache — regenerated by `tsc` and
# `next build`, machine-specific, and over a megabyte.
tsconfig.tsbuildinfo
.DS_Store
public/uploads/jobs/*
!public/uploads/jobs/.gitkeep
*.log
# Every env file, however it's named. `vercel env pull` writes
# .env.production.local, which holds the production database password and
# the Stripe secret key — listing names one at a time is how that ends up
# committed by accident. .env.example carries no real values, so it stays.
.env*
!.env.example
