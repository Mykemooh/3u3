node_modules
.next
.data
# TypeScript's incremental build cache — regenerated by `tsc` and
# `next build`, machine-specific, and over a megabyte.
tsconfig.tsbuildinfo
# Vercel CLI project linkage, written by `vercel link` / `vercel env pull`.
.vercel
.DS_Store
public/uploads/jobs/*
!public/uploads/jobs/.gitkeep
*.log
# Every env file, however it's named. `vercel env pull` writes
# .env.production.local, which holds the production database password and
# the Stripe secret key — listing names one at a time is how that ends up
# committed by accident. .env.example carries no real values, so it stays.
.env*
!.env.example

# Job media written by local dev (production uses R2 / Blob)
public/uploads/photos/
public/uploads/videos/

# Claude Code: personal/machine settings, never shared via git.
.claude/settings.local.json

# Impeccable design skill's compiled engine binary — platform-specific,
# ~14MB, and reinstalled per machine with `npx impeccable install`.
.claude/skills/impeccable/scripts/bin/
